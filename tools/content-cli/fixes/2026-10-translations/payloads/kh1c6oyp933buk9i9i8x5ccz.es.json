              {
                "type": "heading",
                "level": 4,
                "children": [
                  {
                    "text": "<cite>Acompañamos comunidades y administraciones públicas en la evolución de la democracia, activando sus capacidades inherentes para que sus retos se transformen en oportunidades.</cite>",
                    "type": "text"
                  }
