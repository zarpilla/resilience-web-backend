                "children": [
                  {
                    "text": "Regenerative design.",
                    "type": "text"
                  }
                ]
              }
            ],
            "title": null,
            "titleHeading": null,
            "alias": "column 1",
            "media": null,
            "styles": {
              "cssClass": "col-md-5 h3-fw-500",
              "height": null,
              "textColor": "dark",
              "margin": null,
              "padding": "0 50px 0 0",
              "background": "5",
              "width": null,
              "sectionId": null,
              "backgroundColor": null,
              "container": null,
              "paddingTop": null,
