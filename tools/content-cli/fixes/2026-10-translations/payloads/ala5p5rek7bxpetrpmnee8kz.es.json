        "columns": [
          {
            "text": [
              {
                "type": "heading",
                "level": 4,
                "children": [
                  {
                    "text": "<cite>Acompañamos a las organizaciones nacionales e internacionales de derechos humanos, para que puedan evolucionar hacia organizaciones regenerativas, aumentando su impacto y haciéndolo más duradero.</cite>",
                    "type": "text"
                  }
                ]
              }
            ],
            "title": null,
            "titleHeading": null,
            "alias": null,
            "media": null,
            "styles": {
