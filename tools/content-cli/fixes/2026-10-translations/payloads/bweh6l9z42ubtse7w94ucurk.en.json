       {
        "type": "heading",
        "level": 3,
        "children": [
         {
          "text": "<cite>“Resilience has professionals trained in systemic tools to accompany organisations and people in their development towards healthier places.”<cite>",
          "type": "text"
         }
        ]
       },
       {
        "type": "paragraph",
        "children": [
         {
          "text": "- Espai Sistèmic i Humanista",
          "type": "text"
         }
        ]
