   {
    "__component": "sections.columns",
    "alias": null,
    "styles": null,
    "columns": [
     {
      "text": [
       {
        "type": "heading",
        "level": 3,
        "children": [
         {
          "text": "<cite>“The task of Resilience Earth is a clear example of how to bring systemic facilitation beyond people, teams and organizations towards the Bioregional dimension. Its experience allows us to observe how to create a bridge between the regenerative theoretical frameworks and practices, accompanying people to embody and act from the voice of the territory, to the territory.”<cite>",
          "type": "text"
         }
        ]
       },
       {
        "type": "paragraph",
        "children": [
         {
          "text": "- Santiago Scheele of the School of Systemic Facilitation.",
          "type": "text"
         }
        ]
       }
      ],
      "title": null,
      "titleHeading": null,
      "alias": null,
      "media": null,
