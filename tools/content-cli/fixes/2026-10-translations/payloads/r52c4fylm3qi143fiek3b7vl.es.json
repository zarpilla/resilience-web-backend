            "text": [
              {
                "type": "heading",
                "level": 4,
                "children": [
                  {
                    "text": "<cite>Realizamos investigación y diseñamos nuevos procesos colectivos que permitan la autogestión y el empoderamiento de las organizaciones y las comunidades, en un momento de crisis sistémica.</cite>",
                    "type": "text"
                  }
                ]
              }
            ],
            "title": null,
            "titleHeading": null,
            "alias": null,
            "media": null,
            "styles": {
