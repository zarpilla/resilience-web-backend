       "backgroundVideoMobile": null
      },
      "c2a": {
       "text": "Social Balance 2024 results",
       "href": "https://api-w.resilience.earth/uploads/Balanc_social_resilience_earth_2024_849ad8de5a.pdf",
       "target": null,
       "cssClass": "btn btn-dark btn-dark-border-white btn-100 mt-4 zw-100 btn-with-arrow-right",
       "page": null
      },
      "verticalScroller": null
     },
     {
      "text": [
       {
        "type": "heading",
        "level": 3,
        "children": [
         {
          "text": "Social justice and equity.",
          "type": "text"
         }
        ]
       },
       {
        "type": "paragraph",
        "children": [
         {
          "text": "At Resilience.Earth we understand social justice and equity as essential foundations for ecosocial transformation. We work to regenerate relationships between people and the territory, placing healing, diversity and community sovereignty at the centre. We are committed to an intersectional and decolonial perspective that questions privilege, dismantles polarisation and exclusionary power structures, and opens spaces for the voice and leadership of historically oppressed groups. This includes constantly reviewing our practices, relationships and decision-making processes. We are committed to real equity within the team and in our alliances: with transparency in the distribution of resources, encouraging the decentralisation of power and shared roles, and creating safe, accessible and horizontal workspaces.",
          "type": "text"
         }
        ]
       },
       {
        "type": "paragraph",
        "children": [
         {
          "text": "We work for a deep regeneration that not only rethinks our environmental impact but also repairs and heals deep social and cultural wounds, moving towards models of a dignified life for everyone.",
          "type": "text"
         }
        ]
       }
      ],
      "title": "Social Justice and Equity",
      "titleHeading": "h2",
      "alias": "Social Justice and Equity",
      "media": null,
      "styles": null,
      "c2a": null,
      "verticalScroller": null
     }
    ]
