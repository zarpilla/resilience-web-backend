            "verticalScroller": null
          }
        ]
      },
      {
        "__component": "sections.columns",
        "alias": null,
        "styles": null,
        "columns": [
          {
            "text": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "“La labor de Resilience Earth es un claro ejemplo de cómo llevar la Facilitación Sistémica más allá de las personas, los equipos y las organizaciones, hacia la dimensión Bioregional. Su experiencia nos permite observar cómo tender un puente entre los marcos teóricos regenerativos y las prácticas, acompañando a las personas a encarnar y actuar desde la voz del territorio, para el territorio.”",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "text": "- Santiago Scheele de la Escuela de Facilitación Sistémica.",
                    "type": "text"
                  }
                ]
              }
            ],
            "title": null,
            "titleHeading": null,
            "alias": null,
            "media": null,
