          {
            "text": [
              {
                "type": "heading",
                "level": 3,
                "children": [
                  {
                    "text": "“Resilience cuenta con profesionales formadas en herramientas sistémicas para acompañar a organizaciones y personas en su desarrollo hacia lugares más saludables.”",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "text": "– Espacio Sistémico y Humanista",
                    "type": "text"
                  }
                ]
              }
            ],
            "title": null,
            "titleHeading": null,
