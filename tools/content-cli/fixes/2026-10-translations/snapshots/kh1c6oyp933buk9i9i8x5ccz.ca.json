            "text": [
              {
                "type": "heading",
                "level": 4,
                "children": [
                  {
                    "text": "<cite>Acompanyem comunitats i administracions públiques en l’evolució de la democràcia, activant les seves capacitats inherents perquè els seus reptes es transformin en oportunitats.</cite>",
                    "type": "text"
                  }
                ]
