    "sections": [
      {
        "__component": "sections.hero",
        "title": "Resignify Earth from Achille Mbembe's living thought",
        "titleHeading": "h1",
        "text": [
          {
            "type": "heading",
            "level": 3,
            "children": [
              {
                "text": "Decolonization is not only to touch structures. It is to hear again. It's re-imagining. It is to share the Earth again. We present a conversation with Achille Mbembe.",
                "type": "text"
              }
            ]
          }
        ],
