          {
            "text": [
              {
                "type": "heading",
                "level": 2,
                "children": [
                  {
                    "text": "And now what?",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "text": "This dialogue is not a conclusion. It is an interpellation. A cry asking for pause, listen, reconfiguration. Mbembe gives us no recipes. We offer paths. And perhaps the most radical of all is this: to take care of life radically.",
                    "type": "text"
                  }
                ]
              }
            ],
