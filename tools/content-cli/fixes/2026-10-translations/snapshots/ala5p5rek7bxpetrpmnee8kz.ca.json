        "columns": [
          {
            "text": [
              {
                "type": "heading",
                "level": 4,
                "children": [
                  {
                    "text": "<cite>Acompanyem a les organitzacions nacionals i internacionals de drets humans, perquè puguin evolucionar cap a organitzacions regeneratives, augmentant el seu impacte i fent-lo més durador.</cite>",
                    "type": "text"
                  }
                ]
              }
            ],
            "title": null,
            "titleHeading": null,
            "alias": null,
            "media": null,
            "styles": {
              "cssClass": "col-12 col-md-4",
