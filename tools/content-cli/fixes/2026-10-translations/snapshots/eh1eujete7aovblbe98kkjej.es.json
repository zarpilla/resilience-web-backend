                  {
                    "text": "Diseño regenerativo.",
                    "type": "text"
                  }
                ]
              }
            ],
            "title": null,
            "titleHeading": null,
            "alias": "columna 1",
            "media": null,
            "styles": {
              "cssClass": "col-md-5 h3-fw-500",
