        "title": "Gobernanza local con vida en el centro",
        "titleHeading": "h1",
        "text": [
          {
            "type": "heading",
            "level": 3,
            "children": [
              {
                "text": "Una conversación con Melina Ángel sobre la necesidad de priorizar la vida en todas las decisiones y procesos de gobernanza.",
                "type": "text"
              }
            ]
          }
        ],
        "align": "bottom-left",
