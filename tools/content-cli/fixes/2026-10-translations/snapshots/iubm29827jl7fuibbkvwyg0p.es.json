          {
            "text": [
              {
                "type": "heading",
                "level": 2,
                "children": [
                  {
                    "bold": true,
                    "text": "¿Es la participación comunitaria un acto de poder compartido o una ilusión de control democrático?",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "heading",
                "level": 2,
                "children": [
                  {
                    "bold": true,
                    "text": "",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "text": "",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
