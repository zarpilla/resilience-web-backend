        "columns": [
          {
            "text": [
              {
                "type": "heading",
                "level": 4,
                "children": [
                  {
                    "text": "Food sovereignty is more than just producing food. It’s about restoring decision-making power to communities, empowering them to shape resilient, equitable, and sustainable food systems.",
                    "type": "text"
                  }
                ]
              }
            ],
            "title": null,
            "titleHeading": null,
            "alias": null,
            "media": null,
            "styles": {
              "cssClass": "col-0 col-md-4",
