        "columns": [
          {
            "text": [
              {
                "type": "heading",
                "level": 4,
                "children": [
                  {
                    "text": "<cite>Fem recerca i dissenyem nous processos col·lectius que permetin l'autogestió i l'apoderament de les organitzacions i les comunitats, en un moment de crisi sistèmica.</cite>",
                    "type": "text"
                  }
                ]
              }
            ],
            "title": null,
            "titleHeading": null,
            "alias": null,
            "media": null,
            "styles": {
