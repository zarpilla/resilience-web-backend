            "text": [
              {
                "type": "heading",
                "level": 4,
                "children": [
                  {
                    "text": "<cite>La sobirania agroalimentària va més enllà de la producció d’aliments; és una aposta per retornar el poder a les comunitats.</cite>",
                    "type": "text"
                  }
                ]
              }
            ],
            "title": null,
            "titleHeading": null,
