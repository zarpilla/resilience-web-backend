      {
        "__component": "sections.hero",
        "title": "Local governance with life in the center",
        "titleHeading": "h1",
        "text": [
          {
            "type": "heading",
            "level": 3,
            "children": [
              {
                "text": "A conversation with Melina Angel about the need to prioritize life in all decisions and governance processes.",
                "type": "text"
              }
            ]
          }
        ],
        "align": "bottom-left",
        "alias": null,
