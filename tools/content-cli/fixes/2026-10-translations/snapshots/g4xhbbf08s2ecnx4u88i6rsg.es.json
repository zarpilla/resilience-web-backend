      {
        "__component": "sections.hero",
        "title": "Resignificar la Tierra desde el pensamiento vivo de Achille Mbembe",
        "titleHeading": "h1",
        "text": [
          {
            "type": "heading",
            "level": 3,
            "children": [
              {
                "text": "La descolonización no es sólo para tocar estructuras. Es escuchar de nuevo. Está reimaginando. Es compartir la Tierra de nuevo. Presentamos una conversación con Achille Mbembe.",
                "type": "text"
              }
            ]
          }
        ],
