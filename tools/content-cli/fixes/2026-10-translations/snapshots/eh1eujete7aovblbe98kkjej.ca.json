                  {
                    "text": "Disseny Regeneratiu.",
                    "type": "text"
                  }
                ]
              }
            ],
            "title": null,
            "titleHeading": null,
            "alias": "column 1",
            "media": null,
            "styles": {
              "cssClass": "col-md-5 h3-fw-500",
