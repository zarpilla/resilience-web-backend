{
  "collectionName": "components_meta_columns",
  "info": {
    "displayName": "Column",
    "description": ""
  },
  "options": {},
  "attributes": {
    "text": {
      "type": "blocks"
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "width": {
      "type": "integer",
      "min": 1,
      "max": 12
    },
    "offsetLeft": {
      "type": "integer",
      "min": 0,
      "max": 11
    },
    "widthLarge": {
      "type": "integer",
      "min": 1,
      "max": 12
    },
    "styles": {
      "type": "component",
      "repeatable": false,
      "component": "meta.styles",
      "pluginOptions": {
        "translate": {
          "translate": "copy"
        }
      }
    },
    "c2a": {
      "type": "component",
      "repeatable": false,
      "component": "meta.c2-a"
    },
    "buttons": {
      "type": "component",
      "repeatable": true,
      "component": "meta.c2-a"
    },
    "title": {
      "type": "string"
    },
    "titleHeading": {
      "type": "enumeration",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "p"
      ]
    },
    "alias": {
      "type": "string"
    },
    "verticalScroller": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::menu.menu"
    }
  }
}
